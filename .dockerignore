# Version-control and workstation metadata
.git/
.github/
.vscode/
.claude/
.codex/
.docsys/
.dockerignore
.gitignore
/README.md

# Dependencies, build output, and language caches
**/.venv/
**/__pycache__/
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/
**/.cache/
**/node_modules/
**/build/
**/dist/
**/cdk.out/
**/.coverage
**/coverage.xml
**/*.py[cod]
**/*.log
**/*.log.*

# Machine-local configuration, credentials, and infrastructure state must
# never be sent to a Docker daemon or remote BuildKit builder.
**/.env
**/.env.*
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/tfplan
**/terraform.tfvars
**/*.auto.tfvars
**/*.pem
**/*.key
