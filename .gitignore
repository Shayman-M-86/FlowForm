# Rehearsal TLS material is machine-local and explicitly ignored below. The
# Proxmox runtime consumes it while rendering cloud-init, so preserve a working
# local set unless it is being deliberately regenerated.

# Terraform working directories, state, plans, and local values
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/tfplan
**/terraform.tfvars
**/*.auto.tfvars

# Generated Proxmox cloud-init artifacts (templates are source files)
infra/deployment/proxmox/cloud-init/generated/*
!infra/deployment/proxmox/cloud-init/generated/.gitkeep

