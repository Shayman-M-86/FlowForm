{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Python: type check all",
            "type": "shell",
            "command": "scripts/tools/typecheck.sh all",
            "options": {
                "cwd": "${workspaceFolder:root}"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Setup backend",
            "type": "shell",
            "command": "uv sync --project backend --frozen --extra dev --extra test",
            "options": {
                "cwd": "${workspaceFolder:root}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "docs: auto-sync vault",
            "type": "shell",
            "command": "while true; do bash tools/bin/sync-obsidian-vault.sh || true; sleep 600; done",
            "options": {
                "cwd": "${workspaceFolder:root}"
            },
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "close": true
            },
            "problemMatcher": [],
            "detail": "Copies docs/ into the Windows Obsidian vault every 10 minutes. Auto-starts on folder open; stops when VS Code closes. No-ops if the vault path is absent."
        },
        {
            "label": "dev-env: up",
            "type": "shell",
            "command": "scripts/dev/start-dev-stack.sh --keep-data",
            "options": {
                "cwd": "${workspaceFolder:root}"
            },
            "problemMatcher": [],
            "detail": "Refresh secrets and start the local development stack while preserving Postgres volumes."
        },
        {
            "label": "dev-env: down",
            "type": "shell",
            "command": "docker compose -f infra/containers/runtime/development/compose/compose.yml down",
            "options": {
                "cwd": "${workspaceFolder:root}"
            },
            "problemMatcher": []
        },
        {
            "label": "test-env: setup",
            "type": "shell",
            "command": "docker compose --env-file infra/env/dev/.env -p flowform-test-environment -f infra/containers/runtime/development/compose/compose.test.yml up -d --build && docker compose --env-file infra/env/dev/.env -p flowform-test-environment -f infra/containers/runtime/development/compose/compose.test.yml exec backend-test uv sync --extra dev --extra test && docker compose --env-file infra/env/dev/.env -p flowform-test-environment -f infra/containers/runtime/development/compose/compose.test.yml exec backend-test uv python find",
            "options": {
                "cwd": "${workspaceFolder:root}",
                "env": {
                    "FLOWFORM_SECRET_DIR": "${workspaceFolder:root}/infra/env/test/secrets"
                }
            },
            "problemMatcher": [],
            "detail": "Start the integration test stack and report its container interpreter."
        },
        {
            "label": "test-env: up",
            "type": "shell",
            "command": "docker compose --env-file infra/env/dev/.env -p flowform-test-environment -f infra/containers/runtime/development/compose/compose.test.yml up -d --build",
            "options": {
                "cwd": "${workspaceFolder:root}",
                "env": {
                    "FLOWFORM_SECRET_DIR": "${workspaceFolder:root}/infra/env/test/secrets"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "test-env: down",
            "type": "shell",
            "command": "docker compose --env-file infra/env/dev/.env -p flowform-test-environment -f infra/containers/runtime/development/compose/compose.test.yml down",
            "options": {
                "cwd": "${workspaceFolder:root}",
                "env": {
                    "FLOWFORM_SECRET_DIR": "${workspaceFolder:root}/infra/env/test/secrets"
                }
            },
            "problemMatcher": []
        }
    ]
}
