---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import AnimatedApng from "../components/AnimatedApng.astro";
import AdaptiveHeroDemo from "../components/AdaptiveHeroDemo.astro";
import QuestionTypeDemos from "../components/QuestionTypeDemos.astro";
import { NodePageIsland } from "../components/NodePageIsland";
import { GITHUB_URL } from "@flowform/site-shell";
import {
  ArrowRight, CornerDownLeft, Check, CheckCheck,
  Users, UserRound, ClipboardList, LockKeyhole,
  FilePenLine, Send, CalendarClock,
  Microscope, GraduationCap, MessageSquare, ListFilter,
} from "@lucide/astro";
import "../styles/marketing.css";
---

<Layout
  title="FlowForm | Smarter forms. Simpler workflows."
  description="Create surveys that adapt to each person. Bring your forms, participants, and responses together in one organised workspace. Try the builder free, with no account needed."
>
  <SiteHeader />
  <main class="marketing-home">
    <section id="hero" class="marketing-hero">
      <div class="marketing-container hero-grid">
        <div class="hero-copy">
          <span class="marketing-beta">In beta · Free to explore</span>
          <p class="marketing-eyebrow">INTELLIGENT SURVEYS. REAL PEOPLE.</p>
          <h1>Smarter forms.<br /><span>Simpler workflows.</span></h1>
          <p class="hero-description">Build surveys that adapt to each person. Bring your forms, participants, and responses together in one place.</p>
          <div class="marketing-actions">
            <a href="#builder" class="ui-button-primary marketing-primary">Start building <ArrowRight size={18} aria-hidden="true" /></a>
            <a href="#features" class="ui-button-secondary marketing-secondary">See what you can create</a>
          </div>
          <p class="hero-reassurance">No account needed to try the builder.</p>
          <ul class="hero-benefits" aria-label="FlowForm benefits">
            <li><AnimatedApng src="/icons/icons8-settings-48.webp" alt="Adaptive questions" width={25} height={25} /> Questions that adapt</li>
            <li><AnimatedApng src="/icons/icons8-paper-48.webp" alt="Organised projects" width={25} height={25} /> Everything organised</li>
            <li><AnimatedApng src="/icons/icons8-lock-48.webp" alt="Privacy" width={25} height={25} /> Privacy in mind</li>
          </ul>
        </div>
        <AdaptiveHeroDemo />
      </div>
    </section>

    <section id="builder" class="marketing-builder">
      <div class="marketing-container builder-intro">
        <div>
          <p class="marketing-eyebrow">LESS EXPLAINING. MORE EXPLORING.</p>
          <h2>Try the builder. Right here.</h2>
          <p class="section-description">Add a question, give it a little logic, and preview the experience. It’s yours to play with.</p>
        </div>
        <aside class="handwritten-note builder-note" aria-hidden="true">Build it. Preview it.<br />See where it takes you.<CornerDownLeft size={38} stroke-width={1.3} /></aside>
      </div>
      <div class="marketing-container builder-demo-label"><span>YOUR PLAYGROUND</span><p>Saved in this browser · No sign-up · Nothing published</p></div>
      <NodePageIsland client:only="react">
        <div slot="fallback" class="builder-loading" aria-hidden="true">
          <div class="builder-loading__body"><div class="builder-loading__card"><div class="builder-loading__wave"></div></div></div>
        </div>
      </NodePageIsland>
    </section>

    <section id="features" class="marketing-section">
      <div class="marketing-container">
        <div class="section-heading">
          <p class="marketing-eyebrow">MAKE IT YOURS</p>
          <h2>The right question.<br />In just the right format.</h2>
          <p class="section-description">A quick check-in, a detailed study, or something in between. Mix question types, add follow-ups, and see your form through someone else’s eyes.</p>
        </div>
        <div class="builder-steps" aria-label="How to build a form">
          {[
            { src: "/icons/icons8-design-48.webp", title: "Build visually", detail: "Add questions and arrange them your way." },
            { src: "/icons/icons8-goal-48.webp", title: "Make it personal", detail: "Show the questions that fit each answer." },
            { src: "/icons/icons8-search-in-list-48.webp", title: "Try it out", detail: "Preview your form before you share it." },
          ].map(({ src, title, detail }) => (
            <div class="builder-step"><AnimatedApng src={src} alt={title} width={32} height={32} /><div><h3>{title}</h3><p>{detail}</p></div></div>
          ))}
        </div>
        <QuestionTypeDemos />
      </div>
    </section>

    <section id="studio" class="marketing-section marketing-soft-section">
      <div class="marketing-container">
        <div class="section-heading">
          <p class="marketing-eyebrow">BEYOND THE FORM</p>
          <h2>Less scattered.<br />More connected.</h2>
          <p class="section-description">A survey is often just the beginning. FlowForm Studio brings your forms, the people taking part, and the answers they share into one workspace.</p>
        </div>
        <div class="workspace-features">
          <article class="marketing-feature project-feature">
            <span class="feature-icon"><AnimatedApng src="/icons/icons8-settings-48.webp" alt="settings" width={36} height={36} /></span>
            <p class="marketing-eyebrow">ORGANISED PROJECTS</p>
            <h3>A home for every project.</h3>
            <p>Keep related surveys, participants, and responses together. Pick up where you left off without piecing things together across separate tools.</p>
            <div class="project-contents" aria-label="What a project brings together">
              <span><ClipboardList size={19} aria-hidden="true" /> Surveys</span>
              <span><Users size={19} aria-hidden="true" /> Participants</span>
              <span><MessageSquare size={19} aria-hidden="true" /> Responses</span>
            </div>
          </article>
          <article class="marketing-feature participant-feature">
            <span class="feature-icon"><AnimatedApng src="/icons/icons8-verified-account-48.webp" alt="verified account" width={36} height={36} /></span>
            <p class="marketing-eyebrow">PARTICIPANT MANAGEMENT</p>
            <h3>People, not just submissions.</h3>
            <p>Keep track of who’s taking part in your project. Share a public form or give a specific participant their own access link.</p>
            <ul class="feature-checklist">
              <li><Check size={17} aria-hidden="true" /> Organise the people in your project</li>
              <li><Check size={17} aria-hidden="true" /> Choose how each survey is shared</li>
              <li><Check size={17} aria-hidden="true" /> Keep participation connected over time</li>
            </ul>
          </article>
        </div>
        <div class="team-strip">
          <span class="feature-icon"><AnimatedApng src="/icons/icons8-verified-account-48.webp" alt="Team access" width={34} height={34} /></span>
          <div><h3>The right people. The right access.</h3><p>Invite your team and choose who can edit, publish, or review responses. Keep working together without giving everyone the keys to everything.</p></div>
        </div>
      </div>
    </section>

    <section id="security" class="marketing-section">
      <div class="marketing-container">
        <div class="section-heading">
          <p class="marketing-eyebrow">CONFIDENCE COMES BUILT IN</p>
          <h2>Keep improving your forms.<br />Keep their history intact.</h2>
          <p class="section-description">Change is part of the process. Keep collecting with confidence while giving the information people share the care it deserves.</p>
        </div>
        <div class="trust-features">
          <article id="platform" class="marketing-feature publishing-feature">
            <span class="feature-icon"><AnimatedApng src="/icons/icons8-save-48.webp" alt="save" width={36} height={36} /></span>
            <p class="marketing-eyebrow">SAFE PUBLISHING</p>
            <h3>A new draft. A fresh start.<br />The same reliable history.</h3>
            <p>Update your next draft while your published form stays stable. Each response stays linked to the version that collected it.</p>
            <ol class="publishing-steps" aria-label="How publishing protects survey history">
              <li><CheckCheck size={20} aria-hidden="true" /><span><strong>Version 1</strong><small>Published · collecting responses</small></span></li>
              <li><FilePenLine size={20} aria-hidden="true" /><span><strong>Your next draft</strong><small>Make changes at your own pace</small></span></li>
              <li><Send size={20} aria-hidden="true" /><span><strong>Publish when you’re ready</strong><small>Earlier responses keep their context</small></span></li>
            </ol>
          </article>
          <article class="marketing-feature privacy-feature">
            <span class="feature-icon feature-icon--privacy"><AnimatedApng src="/icons/icons8-shield-96.webp" alt="Security shield" width={64} height={64} /></span>
            <p class="marketing-eyebrow">PRIVACY-CONSCIOUS DATA</p>
            <h3>Care for the information<br />people trust you with.</h3>
            <p>Answer data is encrypted before storage and kept separate from account and identifying information. Team permissions control who can access protected information.</p>
            <div class="privacy-pair">
              <div><UserRound size={23} aria-hidden="true" /><strong>People &amp; projects</strong><span>Account and project records</span></div>
              <div><LockKeyhole size={23} aria-hidden="true" /><strong>Protected answers</strong><span>Encrypted and stored separately</span></div>
            </div>
            <p class="feature-footnote">Thoughtful safeguards, from the start.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="roadmap" class="marketing-section marketing-roadmap">
      <div class="marketing-container roadmap-grid">
        <div>
          <span class="planned-badge"><CalendarClock size={15} aria-hidden="true" /> PLANNED · OUR NEXT CHAPTER</span>
          <h2>What if the next step<br />took care of itself?</h2>
          <p class="section-description">A screening form today. A follow-up next week. A reminder at just the right moment. We’re working towards connecting those steps, so there’s less for you to coordinate.</p>
          <p class="roadmap-boundary">These capabilities are planned. Today, you can build adaptive surveys and manage projects, participants, and responses.</p>
        </div>
        <div class="roadmap-cards">
          {[
            { src: "/icons/icons8-settings-48.webp", title: "Connected stages", detail: "Guide people to the next activity based on their answers." },
            { src: "/icons/icons8-running-50.webp", title: "Timely follow-ups", detail: "Plan the next questionnaire around previous interactions." },
            { src: "/icons/icons8-fast-48.webp", title: "Helpful reminders", detail: "Keep people and teams informed when something needs attention." },
          ].map(({ src, title, detail }) => (
            <article><AnimatedApng src={src} alt={title} width={32} height={32} /><div><h3>{title}</h3><p>{detail}</p></div><span>Planned</span></article>
          ))}
        </div>
      </div>
    </section>

    <section id="use-cases" class="marketing-section">
      <div class="marketing-container">
        <div class="section-heading">
          <p class="marketing-eyebrow">YOUR WORK. YOUR WAY.</p>
          <h2>One platform.<br />Plenty of possibilities.</h2>
          <p class="section-description">Start with what you need to learn. Build the experience around the people answering.</p>
        </div>
        <div class="use-case-grid">
          {[
            { Icon: Microscope, title: "Research & studies", detail: "Ask thoughtful questions and keep participants organised." },
            { Icon: ListFilter, title: "Screening & intake", detail: "Guide each person through the questions that apply to them." },
            { Icon: GraduationCap, title: "Assessments & quizzes", detail: "Bring learning to life with choices, ratings, and matching." },
            { Icon: MessageSquare, title: "Feedback & evaluation", detail: "Understand what’s working, and what could be better." },
          ].map(({ Icon, title, detail }) => (
            <article><Icon size={24} stroke-width={1.5} aria-hidden="true" /><h3>{title}</h3><p>{detail}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section id="pricing" class="marketing-final-cta">
      <div class="marketing-container">
        <p class="marketing-eyebrow">GOOD QUESTIONS ARE A GOOD START</p>
        <h2>Make collecting information<br />the easy part.</h2>
        <p>Start with one question. See where it takes you.</p>
        <a href="#builder" class="ui-button-primary marketing-primary">Start building <ArrowRight size={18} aria-hidden="true" /></a>
        <p class="cta-reassurance">Free during beta · No account needed for the demo</p>
      </div>
    </section>

    <footer class="marketing-footer">
      <div class="marketing-container footer-top">
        <a href="/" class="footer-brand"><img src="/FlowForm_logo.png" alt="" width="28" height="28" /><span>FlowForm</span></a>
        <p>Better questions. A more connected way to work.</p>
        <nav aria-label="Footer"><a href="#features">Features</a><a href="#roadmap">What’s next</a><a href="/docs/introduction">Docs</a><a href={GITHUB_URL} target="_blank" rel="noopener">GitHub<span class="sr-only"> (opens a new tab)</span></a><a href="mailto:support@flow-form.com.au">Get in touch</a></nav>
      </div>
      <div class="marketing-container footer-bottom"><span>© {new Date().getFullYear()} FlowForm</span><span>Built with people in mind.</span></div>
    </footer>
  </main>
</Layout>

<script>
  const initCarouselDots = (
    trackSelector: string,
    cardSelector: string,
    dotSelector: string,
  ) => {
    const track = document.querySelector<HTMLElement>(trackSelector);
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>(cardSelector),
    );
    const dots = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(dotSelector),
    );

    if (!track || cards.length === 0 || dots.length === 0) return;

    const setActiveDot = () => {
      const trackCenter =
        track.getBoundingClientRect().left + track.clientWidth / 2;
      let activeIndex = 0;
      let activeDistance = Number.POSITIVE_INFINITY;

      cards.forEach((card, index) => {
        const rect = card.getBoundingClientRect();
        const cardCenter = rect.left + rect.width / 2;
        const distance = Math.abs(trackCenter - cardCenter);

        if (distance < activeDistance) {
          activeDistance = distance;
          activeIndex = index;
        }
      });

      cards.forEach((card, index) => {
        card.dataset.active = String(index === activeIndex);
      });
      dots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.setAttribute("aria-current", "true");
        } else {
          dot.removeAttribute("aria-current");
        }
      });
    };

    track.addEventListener(
      "scroll",
      () => requestAnimationFrame(setActiveDot),
      { passive: true },
    );
    window.addEventListener("resize", setActiveDot);

    dots.forEach((dot) => {
      dot.addEventListener("click", (event) => {
        event.preventDefault();

        const targetId = dot.getAttribute("href")?.slice(1);
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;

        const trackRect = track.getBoundingClientRect();
        const targetRect = target.getBoundingClientRect();
        const nextLeft =
          track.scrollLeft +
          targetRect.left -
          trackRect.left -
          (track.clientWidth - targetRect.width) / 2;

        track.scrollTo({ left: nextLeft, behavior: "smooth" });
      });
    });

    setActiveDot();
  };

  const initCarouselDotIndicators = () => {
    initCarouselDots(".qt-track", ".qt-col", ".qt-dots a");
  };

  document.addEventListener("astro:page-load", initCarouselDotIndicators);
  initCarouselDotIndicators();
</script>
