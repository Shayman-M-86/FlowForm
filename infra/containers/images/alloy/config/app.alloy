// FlowForm app-box observability agent (Grafana Alloy).
//
// Ships backend logs, host journal records, and traces off the private app host.
// The app host does not talk to Grafana directly; it forwards logs to the proxy
// Alloy gateway on :3500 and OTLP traces on :4317 over the private network.
//
// The backend emits one JSON object per log record (FLOWFORM_LOGGING_LOG_JSON=
// true; see backend/app/logging/logging_config.py JsonFormatter). We parse only
// the stable fields needed for labels and retain the original JSON as the Loki
// line. That keeps every sanitized diagnostic field (including exceptions)
// available to `| json` queries without indexing high-cardinality context.
//
// Injected by docker compose from the app bootstrap env:
//   PROXY_GATEWAY_HOST proxy Alloy gateway host (:3500 logs, :4317 traces)
//   FLOWFORM_ENV       deployment identity, such as staging or rehearsal
//   FLOWFORM_PLATFORM  platform identity, such as aws or proxmox

logging {
  level  = "info"
  format = "logfmt"
}

// --- OTLP traces: backend -> local receiver -> proxy-box gateway -------------
otelcol.receiver.otlp "backend" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "traces" {
  output {
    traces = [otelcol.exporter.otlp.proxy_gateway.input]
  }
}

otelcol.exporter.otlp "proxy_gateway" {
  client {
    endpoint = sys.env("PROXY_GATEWAY_HOST") + ":4317"

    tls {
      insecure = true
    }
  }
}

// --- Forward to the proxy-box gateway Alloy ----------------------------------
loki.write "gateway" {
  endpoint {
    url = "http://" + sys.env("PROXY_GATEWAY_HOST") + ":3500/loki/api/v1/push"
  }
}

// --- Host systemd journal ----------------------------------------------------
// Compose already mounts the volatile and persistent journal paths. Forward the
// current boot's role/bootstrap, Docker, and SSM records through the same
// private gateway as container logs. This cannot report a failure that prevents
// Alloy itself from starting, but it preserves the surrounding host evidence
// whenever the observability container comes up.
loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "hostname"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "host" {
  max_age       = "12h"
  relabel_rules = loki.relabel.journal.rules
  labels = {
    job         = "systemd-journal",
    environment = sys.env("FLOWFORM_ENV"),
    platform    = sys.env("FLOWFORM_PLATFORM"),
    host_role   = "app",
  }
  forward_to = [loki.write.gateway.receiver]
}

// --- Docker container logs (backend only lives here) -------------------------
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // service_name is the Grafana Logs Drilldown key. Compose sets
  // com.docker.compose.service (= "backend") on the container.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }

  // Deployment identity is supplied by the role Compose contract.
  rule {
    replacement  = sys.env("FLOWFORM_ENV")
    target_label = "environment"
  }

  rule {
    replacement  = sys.env("FLOWFORM_PLATFORM")
    target_label = "platform"
  }

  rule {
    replacement  = "app"
    target_label = "host_role"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = {job = "docker"}
  forward_to = [loki.process.backend.receiver]
}

// --- Parse the backend's JSON records ----------------------------------------
loki.process "backend" {
  // FlowForm application records are JSON. Gunicorn's native startup banner can
  // be plain text in the same stream; retain the original line in either case.
  stage.match {
    selector = "{service_name=\"backend\"}"

    // Field names match backend JsonFormatter (canonical schema shared with
    // caddy/squid): level, logger, message, method, path, status, client_ip,
    // request_id, duration_ms, event_type, ...
    stage.json {
      expressions = {
        level       = "level",
        logger      = "logger",
        message     = "message",
        method      = "method",
        path        = "path",
        status      = "status",
        client_ip   = "client_ip",
        event_type  = "event_type",
        request_id  = "request_id",
        duration_ms = "duration_ms",
        user_id     = "user_id",
        environment = "environment",
        trace_id    = "trace_id",
        span_id     = "span_id",
      }
    }

    // Index only stable, low-cardinality fields. `path` is the RAW request path
    // (request.path — carries UUIDs), and request_id / duration_ms / status
    // are per-request, so none of them become labels: that would explode Loki
    // stream cardinality. They remain fields in the original JSON line.
    stage.labels {
      values = {
        level      = "",
        method     = "",
        event_type = "",
      }
    }

    // Guard against any stray uppercase level so `{level="error"}` matches the
    // whole fleet (backend already emits lowercase; this is belt-and-braces).
    stage.template {
      source   = "level"
      template = "{{ ToLower .Value }}"
    }

    stage.labels {
      values = {
        level = "",
      }
    }

    // Do not replace the line with a hand-built logfmt subset. The backend
    // already emits valid JSON, including a SensitiveDataFilter-sanitized
    // `exception` field. Keeping that original line prevents query-time
    // JSONParserErr failures and avoids silently discarding diagnostics.
  }

  // --- This agent's own logs: canonical logfmt -------------------------------
  // The app-box Alloy also emits logs into this pipeline. Normalise them to the
  // same schema as the proxy-box agent (see alloy/config.alloy): parse the
  // logfmt fields, label a lowercase `level`, then REBUILD the line as logfmt
  // WITHOUT `ts`/`level` so every field stays queryable via `| logfmt` while the
  // timestamp (Loki's column) and level (the label) aren't duplicated in the
  // body. The `msg=` line filter keeps non-logfmt internal lines (startup
  // banner) out of the decoder so it never emits `failed to decode logfmt`.
  stage.match {
    selector = "{service_name=\"alloy\"} |= \"msg=\""

    stage.logfmt {
      mapping = {
        level     = "",
        msg       = "",
        logger    = "",
        component = "",
      }
    }

    stage.labels {
      values = {
        level = "",
      }
    }

    stage.template {
      source   = "level"
      template = "{{ ToLower .Value }}"
    }

    stage.labels {
      values = {
        level = "",
      }
    }

    // Rebuild as logfmt from the parsed fields, dropping ts/level. Only non-empty
    // fields render, so lines without a component key still stay well-formed.
    stage.template {
      source   = "line"
      template = "{{ if .logger }}logger={{ .logger }} {{ end }}{{ if .component }}component={{ .component }} {{ end }}{{ if .msg }}msg=\"{{ .msg }}\"{{ end }}"
    }

    stage.output {
      source = "line"
    }
  }

  forward_to = [loki.write.gateway.receiver]
}
