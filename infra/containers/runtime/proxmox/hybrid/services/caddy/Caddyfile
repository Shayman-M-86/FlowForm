# Hybrid ingress: Caddy's port is unpublished and only cloudflared reaches it.
# The tunnel's ingress rules decide which public hostnames are forwarded, so
# serve any Host here; public TLS terminates at Cloudflare.
:80 {
	encode zstd gzip

	tracing {
		span caddy.request
	}

	log {
		output stdout
		format filter {
			request>uri regexp "^(/api/v1/account/invitations/resolve/)[^/?]+" "${1}[REDACTED]"
			request>headers>Referer replace REDACTED
			wrap json
		}
	}

	log_append request_id {http.request.uuid}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy http://{$APP_UPSTREAM_HOST}:5000 {
		header_up X-Request-ID {http.request.uuid}

		health_uri /api/v1/system/health/ready
		health_interval 30s
		health_timeout 5s
	}
}
