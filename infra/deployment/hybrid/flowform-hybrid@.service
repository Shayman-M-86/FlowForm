[Unit]
Description=FlowForm hybrid %i convergence
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/flowform/hybrid
EnvironmentFile=/opt/flowform/hybrid/host.env
ExecStart=/opt/flowform/hybrid/converge %i
TimeoutStartSec=25min
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
