{
    "include": [
        "scripts/secrets",
        "tools"
    ],
    "exclude": [
        "**/__pycache__",
        ".pytest_cache",
        ".ruff_cache",
        "**/node_modules",
        "**/.*",
        "tools/flowform_tools/openapi"
    ],
    "extraPaths": [
        "tools"
    ],
    "venvPath": "tools",
    "venv": ".venv",
    "typeCheckingMode": "standard",
    "pythonVersion": "3.14",
    "reportMissingImports": true,
    "reportMissingTypeStubs": false
}
