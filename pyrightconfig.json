{
    "include": [
        "scripts/secrets",
        "tools/agents",
        "tools/docs"
    ],
    "exclude": [
        "**/__pycache__",
        ".pytest_cache",
        ".ruff_cache",
        "**/node_modules",
        "**/.*"
    ],
    "extraPaths": [
        "tools/docs"
    ],
    "typeCheckingMode": "standard",
    "pythonVersion": "3.14",
    "reportMissingImports": true,
    "reportMissingTypeStubs": false
}
