#!/usr/bin/env bash
# PostToolUse quality hook shared by Claude Code and Codex.
#
# Self-contained: resolves its own location, so callers need no PYTHONPATH.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TOOLS_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
REPO_ROOT="$(cd -- "$TOOLS_DIR/.." && pwd)"

cd "$REPO_ROOT"
export PYTHONPATH="$TOOLS_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m flowform_tools.agent_hooks.post_tool_python_quality "$@"
